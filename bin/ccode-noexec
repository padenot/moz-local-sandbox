#!/usr/bin/env python3
"""Track execute permissions without following sandbox-controlled symlinks."""
import json
import os
import stat
import sys


def files(root):
    def fail(error):
        raise error

    for _, _, names, directory in os.fwalk(root, follow_symlinks=False, onerror=fail):
        for name in names:
            try:
                info = os.stat(name, dir_fd=directory, follow_symlinks=False)
            except FileNotFoundError:
                continue
            if stat.S_ISREG(info.st_mode):
                yield directory, name, info


def identity(info):
    return f"{info.st_dev}:{info.st_ino}"


def snapshot(root, destination):
    modes = {identity(info): info.st_mode & 0o111
             for _, _, info in files(root) if info.st_mode & 0o111}
    with open(destination, "x") as output:
        json.dump(modes, output)


def restore(root, source):
    with open(source) as saved:
        modes = json.load(saved)
    count = 0
    for directory, name, info in files(root):
        if not info.st_mode & 0o111:
            continue
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                         dir_fd=directory)
        except FileNotFoundError:
            continue
        try:
            # Use the opened inode, not the earlier pathname: another process
            # may replace an entry between stat and open.
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode):
                continue
            gained = (info.st_mode & 0o111) & ~modes.get(identity(info), 0)
            if gained:
                os.fchmod(fd, stat.S_IMODE(info.st_mode) & ~gained)
                count += 1
        finally:
            os.close(fd)
    if count:
        print(f"mozsb: noexec — stripped gained execute bits from {count} file(s)",
              file=sys.stderr)


if __name__ == "__main__":
    action, root, state = sys.argv[1:]
    {"snapshot": snapshot, "restore": restore}[action](root, state)
